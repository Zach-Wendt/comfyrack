            "min": 0,
            "max": 16384,
            "step": 1
           }
          ],
          "crop": [
           "COMBO",
           {
            "tooltip": "How to handle aspect ratio mismatch: 'disabled' stretches to fit, 'center' crops to maintain aspect ratio.",
